---
import { SITE_NAME, FACEBOOK_URL, CIUDAD, HORARIO } from '../config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="logo">🐾 {SITE_NAME.replace('3D', '')}<span>3D</span></a>
      <p>Impresiones 3D hechas con cariño.<br />{CIUDAD}</p>
    </div>
    <div class="footer-links">
      <strong>Navegación</strong>
      <a href="/catalogo">Catálogo</a>
      <a href="/pedidos">Cómo pedir</a>
      <a href="/faq">FAQ</a>
      <a href="/sobre-mi">Sobre mí</a>
      <a href="/contacto">Contacto</a>
    </div>
    <div class="footer-links">
      <strong>Atención</strong>
      <span>{HORARIO}</span>
      {FACEBOOK_URL && <a href={FACEBOOK_URL} target="_blank" rel="noopener">Facebook Marketplace</a>}
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      © {year} 🐾 {SITE_NAME} · Hecho con amor en Bolivia
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--cream-dark);
    border-top: 2px solid var(--border);
    margin-top: auto;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
    padding: 2.5rem 1.25rem;
  }
  .footer-brand .logo {
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--text);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.5rem;
  }
  .footer-brand .logo span { color: var(--terracotta); }
  .footer-brand p { color: var(--text-muted); font-size: 0.875rem; line-height: 1.6; }
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .footer-links strong { color: var(--text); font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 0.25rem; }
  .footer-links a, .footer-links span { color: var(--text-muted); font-size: 0.875rem; text-decoration: none; }
  .footer-links a:hover { color: var(--terracotta); }
  .footer-bottom {
    border-top: 1px solid var(--border);
    padding: 0.85rem 1.25rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  @media (max-width: 600px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
