---
import { WHATSAPP_BASE_URL } from '../config';

interface Props {
  slug: string;
  nombre: string;
  precio: number;
  material: string;
  imagen: string;
  disponibilidad: string;
  tiempoFabricacion: string;
  mensajeWhatsApp?: string;
  badge?: string;
}

const { slug, nombre, precio, material, imagen, disponibilidad, tiempoFabricacion, mensajeWhatsApp, badge } = Astro.props;

const badgeClass = disponibilidad === 'Stock disponible' ? 'badge-stock' : 'badge-pedido';
const waMsg = mensajeWhatsApp ?? `Hola! Me interesa el ${nombre}. ¿Está disponible?`;
const waUrl = `${WHATSAPP_BASE_URL}?text=${encodeURIComponent(waMsg)}`;
---

<article class="product-card">
  <a href={`/catalogo/${slug}`} class="card-image-link" tabindex="-1" aria-hidden="true">
    <div class="card-image">
      <img src={imagen} alt={nombre} loading="lazy" />
      <span class="material-badge">{material}</span>
      {badge && <span class={`product-badge product-badge--${badge === 'Nuevo' ? 'new' : badge === 'Popular' ? 'popular' : 'low'}`}>{badge}</span>}
    </div>
  </a>
  <div class="card-body">
    <a href={`/catalogo/${slug}`} class="card-title">{nombre}</a>
    <div class="card-price">Bs. {precio}</div>
    <div class="card-meta">
      <span class={`badge ${badgeClass}`}>{disponibilidad}</span>
      <span class="card-time">⏱ {tiempoFabricacion}</span>
    </div>
    <a href={waUrl} target="_blank" rel="noopener" class="btn btn-whatsapp card-btn">
      💬 Pedir por WhatsApp
    </a>
  </div>
</article>

<style>
  .product-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
  }
  .product-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
  .card-image { position: relative; aspect-ratio: 4/3; overflow: hidden; background: var(--cream-dark); }
  .card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s; }
  .product-card:hover .card-image img { transform: scale(1.06); }
  .card-image-link { display: block; }
  .material-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    background: var(--terracotta);
    color: var(--white);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 20px;
    letter-spacing: 0.05em;
  }
  .product-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 20px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .product-badge--new      { background: #22c55e; color: white; }
  .product-badge--popular  { background: #f59e0b; color: white; }
  .product-badge--low      { background: #ef4444; color: white; }
  .card-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .card-title {
    font-weight: 700;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.3;
    text-decoration: none;
  }
  .card-title:hover { color: var(--terracotta); }
  .card-price { font-size: 1.15rem; font-weight: 800; color: var(--terracotta); }
  .card-meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .card-time { font-size: 0.72rem; color: var(--text-muted); }
  .card-btn { margin-top: auto; justify-content: center; font-size: 0.82rem; padding: 0.55rem 1rem; }
</style>
