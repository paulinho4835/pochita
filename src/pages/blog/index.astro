---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('es-BO', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout
  title="Blog"
  description="Artículos sobre impresión 3D, ideas de regalo, consejos y novedades de Pochita3D en Bolivia."
>
  <section class="blog-header">
    <div class="container">
      <h1>Blog</h1>
      <p>Ideas, consejos y todo sobre impresión 3D en Bolivia.</p>
    </div>
  </section>

  <section class="blog-body">
    <div class="container">
      <div class="posts-grid">
        {posts.map(post => (
          <article class="post-card">
            {post.data.imagen && (
              <a href={`/blog/${post.id}`} class="post-img-link">
                <img src={post.data.imagen} alt={post.data.titulo} loading="lazy" class="post-img" />
              </a>
            )}
            <div class="post-body">
              {post.data.categoria && (
                <span class="post-cat">{post.data.categoria}</span>
              )}
              <a href={`/blog/${post.id}`} class="post-title">{post.data.titulo}</a>
              <p class="post-desc">{post.data.descripcion}</p>
              <div class="post-meta">
                <time datetime={post.data.fecha.toISOString()}>{formatDate(post.data.fecha)}</time>
                <a href={`/blog/${post.id}`} class="post-read">Leer →</a>
              </div>
            </div>
          </article>
        ))}
      </div>

      {posts.length === 0 && (
        <p class="empty">Próximamente habrá artículos aquí.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-header { background: var(--cream-dark); border-bottom: 1px solid var(--border); padding: 2.5rem 0 2rem; }
  .blog-header h1 { margin-bottom: 0.5rem; }
  .blog-header p { color: var(--text-muted); }
  .posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.75rem; }
  .post-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column; transition: transform 0.2s, box-shadow 0.2s; }
  .post-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
  .post-img-link { display: block; }
  .post-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .post-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .post-cat { font-size: 0.72rem; font-weight: 700; color: var(--terracotta); text-transform: uppercase; letter-spacing: 0.06em; }
  .post-title { font-weight: 700; font-size: 1rem; color: var(--text); line-height: 1.35; text-decoration: none; }
  .post-title:hover { color: var(--terracotta); }
  .post-desc { color: var(--text-muted); font-size: 0.88rem; line-height: 1.65; flex: 1; }
  .post-meta { display: flex; align-items: center; justify-content: space-between; font-size: 0.78rem; color: var(--text-muted); margin-top: auto; padding-top: 0.5rem; border-top: 1px solid var(--border); }
  .post-read { color: var(--terracotta); font-weight: 600; text-decoration: none; }
  .post-read:hover { text-decoration: underline; }
  .empty { color: var(--text-muted); text-align: center; padding: 3rem 0; }
</style>
