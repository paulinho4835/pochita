---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WHATSAPP_BASE_URL, FACEBOOK_URL, CIUDAD, HORARIO } from '../config';
const waUrl = `${WHATSAPP_BASE_URL}?text=${encodeURIComponent('Hola Pochita3D! Quiero hacer una consulta.')}`;
---

<BaseLayout title="Contacto" description="Contactá a Pochita3D por WhatsApp o Messenger para pedidos y consultas.">
  <section class="page-header">
    <div class="container">
      <h1>Contacto</h1>
      <p>La forma más rápida de contactarnos es por WhatsApp.</p>
    </div>
  </section>

  <section>
    <div class="container contact-grid">
      <div class="contact-card">
        <div class="contact-icon">💬</div>
        <h3>WhatsApp</h3>
        <p>Respondemos rápido. Ideal para consultas, pedidos y presupuestos.</p>
        <a href={waUrl} target="_blank" rel="noopener" class="btn btn-whatsapp">
          Abrir WhatsApp
        </a>
      </div>

      {FACEBOOK_URL && (
        <div class="contact-card">
          <div class="contact-icon">📘</div>
          <h3>Facebook Marketplace</h3>
          <p>También puedes encontrarnos y contactarnos por Marketplace.</p>
          <a href={FACEBOOK_URL} target="_blank" rel="noopener" class="btn btn-outline">
            Ver en Facebook
          </a>
        </div>
      )}

      <div class="contact-card">
        <div class="contact-icon">📍</div>
        <h3>Ubicación</h3>
        <p>{CIUDAD}</p>
        <p class="contact-detail">Hacemos envíos a todo Bolivia por encomienda.</p>
      </div>

      <div class="contact-card">
        <div class="contact-icon">🕐</div>
        <h3>Horario de atención</h3>
        <p>{HORARIO}</p>
        <p class="contact-detail">Fuera de horario puedes escribir igual — respondemos al retomar actividad.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { background: var(--cream-dark); border-bottom: 1px solid var(--border); padding: 2.5rem 0; }
  .page-header h1 { margin-bottom: 0.5rem; }
  .page-header p { color: var(--text-muted); }
  .contact-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; }
  .contact-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.75rem; }
  .contact-icon { font-size: 2.5rem; margin-bottom: 0.75rem; }
  .contact-card h3 { margin-bottom: 0.5rem; }
  .contact-card p { color: var(--text-muted); line-height: 1.6; margin-bottom: 0.5rem; font-size: 0.9rem; }
  .contact-detail { font-size: 0.82rem; }
  .contact-card .btn { margin-top: 0.75rem; }
</style>
